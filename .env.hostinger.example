# Copie para .env no servidor da Hostinger e preencha.
APP_NAME="Soares Mudanças"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://soaresmudancas.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# hPanel → Bancos de dados → MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_soares
DB_USERNAME=u000000000_soares
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# hPanel → E-mails → contato@soaresmudancas.com
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contato@soaresmudancas.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@soaresmudancas.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile (opcional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
